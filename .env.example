# ---------------------------------------------------------------- modes
# HARD RULE: stays true until you are ready to spend real money.
MOCK_MODE=true
LOG_LEVEL=INFO

# ------------------------------------------------------------- telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to drive the bot (find yours via @userinfobot)
OPERATOR_CHAT_IDS=
# Only set when running a self-hosted Bot API server (large in-chat uploads)
TELEGRAM_API_BASE_URL=

# ----------------------------------------------------------- elevenlabs
# VOICE IS A PLACEHOLDER — the final Dennis voice is a to-be-decided,
# one-line change. Audition shortlist (stock ElevenLabs premades):
#   Brian (dry/deadpan) · Charlie (casual everyman) · George (weary/raspy)
# Deadpan settings live in config.py: stability ~0.65-0.75, style low,
# rate slightly slow. The model defaults to the Turbo tier (~half the
# credit cost per character).
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID_SHORT=
ELEVEN_VOICE_ID_LONG=
# Flip only if you want the premium multilingual model
ELEVEN_USE_PREMIUM=false

# ----------------------------------------------------------------- cost
# Estimated $ per 1000 TTS characters (used for the pre-approval report)
USD_PER_1K_CHARS=0.15
MONTHLY_SPEND_CAP=50.0
# SHORT is 60-75s (~1200 chars); LONG is complexity-driven up to ~40 min
SHORT_MAX_CHARS=1200
LONG_MAX_CHARS=36000

# ------------------------------------------------------ content engine
PEXELS_API_KEY=
# [MEME] fallbacks — tried only on an owned-library miss and only when set
# (imgflip's get_memes endpoint is keyless; Wikimedia needs no key)
GIPHY_API_KEY=
TENOR_API_KEY=

# ------------------------------------------- filings (10-K auto-screenshot)
# After a LONG angle is picked, Dennis pulls the latest 10-K from SEC EDGAR,
# flags smoking-gun quotes with a cheap LLM, and screenshots them for
# [SHOW FILING] — no manual uploads. All offline + $0 in MOCK_MODE.
FILINGS_ENABLED=true
# SEC requires a declared User-Agent for live pulls (e.g. "Jane Doe jane@x.com")
SEC_USER_AGENT=
FILINGS_MAX_SHOTS=3
FILINGS_INCLUDE_10Q=false
# Quote flagger: github (free-tier gpt-4o-mini) | openai | mock. Swappable.
FILINGS_LLM_PROVIDER=github
FILINGS_LLM_MODEL=gpt-4o-mini
GITHUB_MODELS_TOKEN=
# Only if FILINGS_LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional: pin the headless Chromium binary (else Playwright's default)
PLAYWRIGHT_CHROMIUM_PATH=

# ------------------------------------------------------------- delivery
# gdrive | s3 | telegram | local
DELIVERY_BACKEND=gdrive
# Path to a Google service-account JSON (or OAuth client JSON with refresh_token)
GDRIVE_CREDENTIALS=
GDRIVE_ROOT_FOLDER_ID=
# S3 alternative (requires: pip install .[s3])
S3_BUCKET=
S3_REGION=us-east-1

# ----------------------------------------------------------------- jobs
RETENTION_DAYS=14

# ------------------------------------------------------------- screener
SCREEN_TOP_N=8
COOLDOWN_DAYS=30
# 5-field cron in SCREEN_TIMEZONE (default: 07:30 ET, weekdays)
SCREEN_DIGEST_CRON=30 7 * * 1-5
SCREEN_TIMEZONE=America/New_York

# ------------------------------------------------------------ editorial
DISCLAIMER_TEXT=Opinion / entertainment. Not financial advice.

# ------------------------------------------------------ render politeness
# The render box doubles as a desktop. FFmpeg is capped to a share of the
# cores and runs de-prioritised so an unattended render never makes the
# machine unusable. RENDER_THREADS pins an exact count (0 = derive from the
# fraction).
RENDER_THREAD_FRACTION=0.5
RENDER_THREADS=0
RENDER_BELOW_NORMAL_PRIORITY=true

# ----------------------------------------------------------- LLM routing
# Cheap passes (fact-check assist, skeptic, filings flagger) run local-first:
# a 7-8B model on the render box's GPU has no rate limit and no quota, and is
# still $0. Hosted tiers are the fallback. Empty = ollama,github,openai.
LLM_PROVIDER_ORDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# --------------------------------------------------------- data freshness
# Refuse (or warn about) a render built on a stale snapshot. When the bot
# refreshed the workbook itself, the age is measured from that refresh — not
# from the sheet's =TODAY() and not from the file's mtime.
DATA_MAX_AGE_DAYS=10
DATA_STALE_BLOCKS=false

# ------------------------------------------------------- standing state
# What the bot remembers between sessions: each covered ticker's thesis and
# the numbers behind it, a ranked idea backlog, and renders queued to run
# unattended overnight. /ideas /thesis /batch drive it from chat.
THESIS_TRACKING=true
IDEA_QUEUE_MAX_AGE_DAYS=30
# /repurpose cuts this many clips out of a finished LONG (was 1).
REPURPOSE_CLIPS=3
# The unattended window, LOCAL time (crossing midnight is fine). The render
# box is a desktop that sleeps — a batch that doesn't run is a non-event, the
# work simply waits.
BATCH_ENABLED=true
BATCH_START_HOUR=1
BATCH_END_HOUR=7

# ------------------------------------------------------ local TTS (drafts)
# A third audio tier between the mock hum and the paid voice: a local neural
# voice (Piper) on the render box's GPU. Free, listenable, and marked DRAFT —
# its word timings are exact per sentence and interpolated within one, so the
# renderer refuses to make a final out of it. Iterate on pacing for nothing;
# spend one ElevenLabs generation on the final.
# Without Piper installed a draft falls back to the mock hum, never to paid.
LOCAL_TTS_ENABLED=true
LOCAL_TTS_BINARY=piper
# Path to a .onnx voice, e.g. en_GB-northern_english_male-medium.onnx
LOCAL_TTS_MODEL=
LOCAL_TTS_SPEAKER=-1
LOCAL_TTS_CUDA=true

# ------------------------------------------------------- Excel data refresh
# On the Windows box, with Excel and the LSEG/Capital IQ add-in loaded, the
# bot refreshes the data template itself and the manual upload becomes the
# fallback. Off-Windows this is inert.
EXCEL_REFRESH_ENABLED=true
# Blank uses templates/dennis_data_template.xlsx.
EXCEL_TEMPLATE_PATH=
# v3.1 template: the plain ticker goes in Snapshot!C3 (every CIQ formula reads
# it); B3 DERIVES the Refinitiv RIC from it and must not be written.
EXCEL_TICKER_CELL=C3
# The RIC override cell. Normally left empty: the template looks the suffix up
# from the exchange itself. Set EXCEL_SYMBOL_SUFFIX to force one (".O" makes
# PLTR into PLTR.O), or pin per ticker from chat: /refresh PLTR PLTR.O
EXCEL_RIC_CELL=E2
EXCEL_SYMBOL_SUFFIX=
# Which macro fires the add-in's refresh differs by vintage. Blank tries the
# known candidates in turn and falls back to a full recalculation. Set it to
# the one that works on this box to skip the guessing.
EXCEL_REFRESH_MACROS=
# The refresh is asynchronous: finishing early yields a workbook full of
# blanks that looks like success, so the poll is generous and running out of
# time is a hard failure, never accepted as data.
EXCEL_REFRESH_TIMEOUT_S=240
EXCEL_POLL_INTERVAL_S=2
EXCEL_SETTLE_POLLS=3
# Leave false — a visible Excel is only useful when debugging the add-in.
EXCEL_VISIBLE=false

# --------------------------------------------------------- segmented render
# Encode each beat as its own clip — content-hash cached, encoded in parallel
# within the politeness budget, and resumable across a reboot — then concat.
# false falls back to the original monolithic filter_complex.
RENDER_SEGMENTED=true
