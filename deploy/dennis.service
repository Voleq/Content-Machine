[Unit]
Description=Dennis — Telegram video pipeline bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dennis
Group=dennis
WorkingDirectory=/opt/dennis
EnvironmentFile=/opt/dennis/.env
ExecStart=/opt/dennis/.venv/bin/python main.py
Restart=on-failure
RestartSec=5
# renders are CPU-heavy; keep the box responsive
Nice=5
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/dennis

[Install]
WantedBy=multi-user.target
