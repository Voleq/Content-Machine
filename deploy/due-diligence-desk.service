[Unit]
Description=Due Diligence Desk — Telegram video pipeline bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ddd
Group=ddd
WorkingDirectory=/opt/due-diligence-desk
EnvironmentFile=/opt/due-diligence-desk/.env
ExecStart=/opt/due-diligence-desk/.venv/bin/python main.py
Restart=on-failure
RestartSec=5
# renders are CPU-heavy; keep the box responsive
Nice=5
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/due-diligence-desk

[Install]
WantedBy=multi-user.target
